{
  "name": "speedreader",
  "private": true,
  "description": "Dev tooling for the Speed Reader Chrome extension",
  "scripts": {
    "dev": "web-ext run --target chromium --source-dir speed-reader-extension --start-url https://en.wikipedia.org/wiki/Speed_reading",
    "zip": "web-ext build --source-dir speed-reader-extension --artifacts-dir dist --overwrite-dest --filename speed-reader-{version}.zip",
    "test": "npm run test:unit && npm run test:e2e",
    "test:unit": "node --test \"tests/unit/*.test.mjs\"",
    "test:e2e": "node --test \"tests/e2e/*.test.mjs\""
  },
  "devDependencies": {
    "chrome-webstore-upload-cli": "4.0.1",
    "puppeteer": "25.12.0",
    "web-ext": "10.7.0"
  },
  "engines": {
    "node": ">=22"
  }
}
