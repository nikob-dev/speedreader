{
  "manifest_version": 3,
  "name": "Speed Reader — RSVP",
  "version": "1.4.0",
  "description": "Speed read any page or selection one word at a time. Highlight text, double-tap Shift, and read at up to 900 words per minute.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": ["scripting", "contextMenus", "storage"],
  "host_permissions": ["<all_urls>"],
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["reader-core.js", "content.js"],
      "run_at": "document_idle"
    }
  ]
}
